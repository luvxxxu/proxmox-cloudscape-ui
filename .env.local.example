# HTTPS URL of one Proxmox node. Use a hostname/IP in its certificate SAN.
PROXMOX_HOST=https://pve.example.internal:8006
# Production requires your exact public HTTPS origin, without a trailing slash.
APP_ORIGIN=https://proxmox-ui.example.com
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Export this BEFORE starting Node. Next .env loading is too late for Node TLS.
# Docker Compose sets /run/certs/proxmox-ca.pem automatically.
# NODE_EXTRA_CA_CERTS=/etc/proxmox-cloudscape/proxmox-ca.pem
# Optional request timeouts in milliseconds (normal requests / multipart uploads).
PROXMOX_REQUEST_TIMEOUT_MS=60000
PROXMOX_UPLOAD_TIMEOUT_MS=7200000
# No server API token: every request uses the signed-in user's Proxmox ticket.
