{
  "name": "cloudscape-proxmox-ui",
  "version": "0.2.2",
  "private": true,
  "scripts": {
    "dev": "node server/custom-server.js",
    "dev:all": "node server/custom-server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server/custom-server.js",
    "lint": "eslint --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run test",
    "package:source": "bun scripts/package-source.mjs",
    "schema:update": "bun scripts/update-api-schema.mjs",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@cloudscape-design/board-components": "^3.0.226",
    "@cloudscape-design/collection-hooks": "^1.0.107",
    "@cloudscape-design/components": "^3.0.1365",
    "@cloudscape-design/design-tokens": "^3.0.111",
    "@cloudscape-design/global-styles": "^1.0.68",
    "@next/env": "16.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "next": "16.3.4",
    "novnc": "github:novnc/noVNC#8e1ebdf",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=24 <25",
    "bun": ">=1.3.12"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
